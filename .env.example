# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# --- Option 1: Service Account (recommended for automation/servers) ---
# Path to your downloaded service account JSON key file.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# --- Option 2: OAuth2 (for user-delegated access) ---
# Path to the credentials.json downloaded from Google Cloud Console.
# On first run this opens a browser login; token.json is saved for reuse.
# GOOGLE_CREDENTIALS_FILE=credentials.json
